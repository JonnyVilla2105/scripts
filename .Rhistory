tiempos3$dist_relativa[i] /
(velocidad_prom[[i,j]] *1000/60),
TRUE ~ tiempos3[[i,j]])
tiempos3[[i,j]]  <- case_when(is.na(tiempos3[[i,j]]) ~ 0,
TRUE ~ tiempos3[[i,j]])
}
}
